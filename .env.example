# Generate a local gateway credential with python -c "import secrets; print(secrets.token_urlsafe(32))"
CERBERUS_API_KEY=
CERBERUS_POLICY=strict
CERBERUS_REQUESTS_PER_MINUTE=60
CERBERUS_DATABASE_URL=sqlite:///cerberus.sqlite3
CERBERUS_PROVIDER=ollama
CERBERUS_MODEL=qwen2.5:0.5b
# Defaults follow the selected provider. Ollama on the host uses http://127.0.0.1:11434.
# CERBERUS_PROVIDER_URL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CERBERUS_SYSTEM_PROMPT=
# CERBERUS_SCHEMA_FILE=
# CERBERUS_HASH_KEY=
# CERBERUS_CLASSIFIER_PATH=
